<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- `just daemon-load <config>` replaces @CONFIG@ with the config's absolute path. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.mei.kasaned</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/kasaned</string>
		<string>@CONFIG@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/kasaned.log</string>
</dict>
</plist>
