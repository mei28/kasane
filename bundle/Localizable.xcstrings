{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "A key was still down when the recording ended.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が終わったとき、まだ押されているキーがありました。"
          }
        }
      }
    },
    "A shortcut also reaches the app in front, so pick one no app uses.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットは前面のアプリにも届きます。アプリが使っていない組み合わせを選んでください。"
          }
        }
      }
    },
    "A shortcut ends with one key, such as K in ⌃⌥⌘K.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットの最後のキーは 1 つにしてください（⌃⌥⌘K の K）。"
          }
        }
      }
    },
    "A shortcut needs ⌃ or ⌘.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットには ⌃ か ⌘ を含めてください。"
          }
        }
      }
    },
    "A tap trigger needs 2 to 5 taps, not %lld.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップの回数は 2〜5 回にしてください（今は %lld 回です）。"
          }
        }
      }
    },
    "About Kasane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane について"
          }
        }
      }
    },
    "Add…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加…"
          }
        }
      }
    },
    "Another recording is in progress.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの記録が進んでいます。"
          }
        }
      }
    },
    "Block and Unblock": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止める・戻す"
          }
        }
      }
    },
    "Block the Built-in Keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵キーボードを止める"
          }
        }
      }
    },
    "Blocks the built-in keyboard, and unblocks it when pressed again. Blocking works only while an external keyboard is connected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵キーボードを止めます。止めているときに押すと戻します。外付けキーボードがつながっている間だけ止められます。"
          }
        }
      }
    },
    "Built-in keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵キーボード"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Cannot reach kasaned": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kasaned につながりません"
          }
        }
      }
    },
    "Cannot read the config from kasaned: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kasaned から設定を読めません：%@"
          }
        }
      }
    },
    "External keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けキーボード"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般"
          }
        }
      }
    },
    "Hold %@ for %@ s": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を %2$@ 秒長押し"
          }
        }
      }
    },
    "Hold %@ for %@ s on the built-in keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵の %1$@ を %2$@ 秒長押し"
          }
        }
      }
    },
    "Hold %@ for %@ s on the external keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けの %1$@ を %2$@ 秒長押し"
          }
        }
      }
    },
    "Hold all the keys down at the same time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのキーを同時に押し続けてください。"
          }
        }
      }
    },
    "Hold the keys for at least half a second.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを 0.5 秒以上押し続けてください。"
          }
        }
      }
    },
    "Input Monitoring is not granted to Kasane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane に入力監視が許可されていません"
          }
        }
      }
    },
    "Kasane Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane の設定"
          }
        }
      }
    },
    "Kasane cannot start": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane を起動できません"
          }
        }
      }
    },
    "Kasane is paused": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane は一時停止中です"
          }
        }
      }
    },
    "Keep at least one way back on the external keyboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けキーボードで戻すキーを、少なくとも 1 つ残してください。"
          }
        }
      }
    },
    "Keys came from both keyboards. Use one keyboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 つのキーボードからキーが届きました。1 つのキーボードで押してください。"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        }
      }
    },
    "Left Command": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左 Command"
          }
        }
      }
    },
    "Left Control": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左 Control"
          }
        }
      }
    },
    "Left Option": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左 Option"
          }
        }
      }
    },
    "Left Shift": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左 Shift"
          }
        }
      }
    },
    "No built-in keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵キーボードが見つかりません"
          }
        }
      }
    },
    "No key was pressed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが押されませんでした。"
          }
        }
      }
    },
    "None": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし"
          }
        }
      }
    },
    "One tap cannot be a trigger. Tap 2 to 5 times.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回のタップはトリガにできません。2〜5 回タップしてください。"
          }
        }
      }
    },
    "Open Input Monitoring Settings…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視の設定を開く…"
          }
        }
      }
    },
    "Pause Kasane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane を一時停止"
          }
        }
      }
    },
    "Press %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を押す"
          }
        }
      }
    },
    "Press %@ %lld times": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を %2$lld 回押す"
          }
        }
      }
    },
    "Press %@ %lld times on the built-in keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵の %1$@ を %2$lld 回押す"
          }
        }
      }
    },
    "Press %@ %lld times on the external keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けの %1$@ を %2$lld 回押す"
          }
        }
      }
    },
    "Press %@ on the built-in keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵の %@ を押す"
          }
        }
      }
    },
    "Press %@ on the external keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けの %@ を押す"
          }
        }
      }
    },
    "Press the keys on the external keyboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けキーボードでキーを押してください。"
          }
        }
      }
    },
    "Press the new keys. Recording ends one second after you let go.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいキーを押してください。手を離して 1 秒たつと、記録が終わります。"
          }
        }
      }
    },
    "Quit Kasane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane を終了"
          }
        }
      }
    },
    "Recording a trigger…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガを記録しています…"
          }
        }
      }
    },
    "Relaunch Kasane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane を再起動"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "Restore": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻す"
          }
        }
      }
    },
    "Restore the Default Config": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の設定に戻す"
          }
        }
      }
    },
    "Restore the Default Config…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の設定に戻す…"
          }
        }
      }
    },
    "Restore the default config?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の設定に戻しますか？"
          }
        }
      }
    },
    "Resume Kasane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasane を再開"
          }
        }
      }
    },
    "Right Command": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右 Command"
          }
        }
      }
    },
    "Right Control": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右 Control"
          }
        }
      }
    },
    "Right Option": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右 Option"
          }
        }
      }
    },
    "Right Shift": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右 Shift"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定…"
          }
        }
      }
    },
    "Space": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペース"
          }
        }
      }
    },
    "System default": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの設定"
          }
        }
      }
    },
    "Tap one key only.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのキーだけをタップしてください。"
          }
        }
      }
    },
    "Taps of %@ on the %@ use different counts. Use one count per key.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の %1$@ のタップで、回数がそろっていません。1 つのキーでは回数をそろえてください。"
          }
        }
      }
    },
    "That was %lld taps. Tap 2 to 5 times.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 回のタップでした。2〜5 回タップしてください。"
          }
        }
      }
    },
    "The built-in keyboard cannot have hold triggers: the external keyboard's weight could hold a key down.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵キーボードには、押し続けるトリガを置けません。外付けキーボードの重みで、キーが押されたままになることがあるためです。"
          }
        }
      }
    },
    "The built-in keyboard is blocked": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵キーボードを止めています"
          }
        }
      }
    },
    "The built-in keyboard works": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵キーボードは使えます"
          }
        }
      }
    },
    "The config file is from an older version or damaged.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルが古い形か、壊れています。"
          }
        }
      }
    },
    "The keys you added are removed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したキーは消えます。"
          }
        }
      }
    },
    "The menu bar updates after a relaunch.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーは、再起動すると切り替わります。"
          }
        }
      }
    },
    "These keys are already in the list.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じキーがすでにあります。"
          }
        }
      }
    },
    "This key cannot be used. Use letters, digits, Space, Return, Tab, Escape, Delete, the arrow keys, fn, or the modifier keys.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーは使えません。使えるのは、文字、数字、スペース、Return、Tab、Escape、Delete、矢印、fn、修飾キーです。"
          }
        }
      }
    },
    "Turn on Kasane under Input Monitoring.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視で Kasane をオンにしてください。"
          }
        }
      }
    },
    "Unblock from the External Keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けで戻す"
          }
        }
      }
    },
    "Unblock the Built-in Keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵キーボードを戻す"
          }
        }
      }
    },
    "Unblocks the built-in keyboard from the external one, for when the keys above are out of reach. Only keys pressed on the external keyboard can be recorded.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止めるキーに手が届かないときに、外付けキーボードから内蔵キーボードを戻します。外付けキーボードで押したキーだけを記録できます。"
          }
        }
      }
    },
    "Unknown key: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知らないキーです：%@"
          }
        }
      }
    },
    "Waiting for an external keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けキーボードを待っています"
          }
        }
      }
    },
    "both Command keys": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の Command"
          }
        }
      }
    },
    "both Control keys": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の Control"
          }
        }
      }
    },
    "both Option keys": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の Option"
          }
        }
      }
    },
    "both Shift keys": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の Shift"
          }
        }
      }
    },
    "fn cannot be part of a shortcut.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fn はショートカットに使えません。"
          }
        }
      }
    },
    "kasaned cannot use its config file": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kasaned が設定ファイルを使えません"
          }
        }
      }
    },
    "kasaned is not running. Install it with just install.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kasaned が動いていません。just install でインストールしてください。"
          }
        }
      }
    }
  }
}
